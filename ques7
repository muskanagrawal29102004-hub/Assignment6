
using System;
using System.Data;
using System.Data.SqlClient;

class ques7
{
    static void Main7()
    {
        // Connection String
        string conStr = @"Data Source=localhost;
        Initial Catalog=CollegeDB1;
        Integrated Security=True";

        try
        {
            // Create SqlConnection object
            SqlConnection con = new SqlConnection(conStr);

            // Create SqlDataAdapter
            SqlDataAdapter da = new SqlDataAdapter(
                "SELECT * FROM Student", con);

            // Create DataSet
            DataSet ds = new DataSet();

            // Fill DataSet
            da.Fill(ds, "Student");

            // Take input from user
            Console.Write("Enter Student ID to Update: ");
            int id = Convert.ToInt32(Console.ReadLine());

            Console.Write("Enter New Student Name: ");
            string name = Console.ReadLine();

            Console.Write("Enter New Age: ");
            int age = Convert.ToInt32(Console.ReadLine());

            Console.Write("Enter New Course: ");
            string course = Console.ReadLine();

            // Access DataTable
            DataTable dt = ds.Tables["Student"];

            // Find existing record
            DataRow row = dt.Rows.Find(id);

            if (row != null)
            {
                // Update record
                row["Name"] = name;
                row["Age"] = age;
                row["Course"] = course;

                // Create CommandBuilder
                SqlCommandBuilder cb = new SqlCommandBuilder(da);

                // Update database
                da.Update(ds, "Student");

                Console.WriteLine("Student Record Updated Successfully!");
            }
            else
            {
                Console.WriteLine("Student Record Not Found!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }

        Console.ReadKey();
    }
}

