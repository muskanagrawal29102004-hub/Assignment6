
using System;
using System.Data.SqlClient;

class QUES3
{
    static void Main3()
    {
        // Connection String
        string conStr = @"Data Source=localhost;
                          Initial Catalog=CollegeDB1;
                          Integrated Security=True";

        // Create SqlConnection object
        SqlConnection con = new SqlConnection(conStr);

        try
        {
            // Open database connection
            con.Open();

            Console.WriteLine("Database Connected Successfully!");

            // Take input from user
            Console.Write("Enter Student ID to Update: ");
            int id = Convert.ToInt32(Console.ReadLine());

            Console.Write("Enter New Student Name: ");
            string name = Console.ReadLine();

            Console.Write("Enter New Age: ");
            int age = Convert.ToInt32(Console.ReadLine());

            // Update query
            string query = "UPDATE Student SET Name = @Name, Age = @Age WHERE StudentID = @ID";

            // Create SqlCommand object
            SqlCommand cmd = new SqlCommand(query, con);

            // Add parameters
            cmd.Parameters.AddWithValue("@Name", name);
            cmd.Parameters.AddWithValue("@Age", age);
            cmd.Parameters.AddWithValue("@ID", id);

            // Execute update query
            int result = cmd.ExecuteNonQuery();

            if (result > 0)
            {
                Console.WriteLine("Student Record Updated Successfully!");
            }
            else
            {
                Console.WriteLine("Student Record Not Found!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
        finally
        {
            // Close database connection
            con.Close();
        }

        Console.ReadKey();
    }
}

