
using System;
using System.Data;
using System.Data.SqlClient;

class ques5
{
    static void Main5()
    {
        // Connection String
        string conStr = @"Data Source=localhost;
        Initial Catalog=CollegeDB1;
        Integrated Security=True";

        try
        {
            // Create SqlConnection object
            SqlConnection con = new SqlConnection(conStr);

            // SQL Query
            string query = "SELECT * FROM Student";

            // Create SqlDataAdapter object
            SqlDataAdapter da = new SqlDataAdapter(query, con);

            // Create DataSet object
            DataSet ds = new DataSet();

            // Fill DataSet with records
            da.Fill(ds, "Student");

            Console.WriteLine("Student Records:");

            // Access DataTable from DataSet
            DataTable dt = ds.Tables["Student"];

            // Display all records
            foreach (DataRow row in dt.Rows)
            {
                Console.WriteLine("Student ID: " + row["StudentId"]);
                Console.WriteLine("Name: " + row["Name"]);
                Console.WriteLine("Age: " + row["Age"]);
                Console.WriteLine("Course: " + row["Course"]);
                Console.WriteLine("----------------------");
            }

            Console.WriteLine("Records Retrieved Successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }

        Console.ReadKey();
    }
}

